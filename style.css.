
body {
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
}

#map {
  width: 100vw;
  height: 100vh;
}

.map-title,
.map-legend {
  position: absolute;
  z-index: 10;
  background: rgba(255, 255, 255, 0.94);
  padding: 12px 16px;
  border-radius: 6px;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.15);
}

.map-title {
  top: 20px;
  left: 20px;
}

.map-title h2 {
  font-size: 19px;
  margin: 0 0 5px;
}

.map-title p {
  font-size: 12px;
  margin: 0;
  color: #555;
}

.map-legend {
  bottom: 30px;
  left: 20px;
  font-size: 13px;
}

.map-legend h3 {
  font-size: 14px;
  margin: 0 0 10px;
}

.map-legend div {
  display: flex;
  align-items: center;
  margin: 7px 0;
}

.swatch {
  width: 16px;
  height: 16px;
  margin-right: 9px;
  border: 1px solid #aaa;
}

.small  { background: #B9D8A7; }
.medium { background: #79AD77; }
.large  { background: #275D45; }
